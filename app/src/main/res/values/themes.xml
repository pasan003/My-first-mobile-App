<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using Material 3 -->
    <style name="Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">#FFB2DFDB</item>
        <item name="colorOnPrimaryContainer">#FF00201E</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">#FFB2DFDB</item>
        <item name="colorOnSecondaryContainer">#FF00201E</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">#FF4D8C6B</item>
        <item name="colorOnTertiary">#FFFFFFFF</item>

        <!-- Surface and Background -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Error color -->
        <item name="colorError">#FFC62828</item>
        <item name="colorOnError">#FFFFFFFF</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/balance_card_start</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_wrapper</item>
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
