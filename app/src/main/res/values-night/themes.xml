<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme using Material 3 -->
    <style name="Theme.MyApplication" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">#FF80CBC4</item>
        <item name="colorOnPrimary">#FF003731</item>
        <item name="colorPrimaryContainer">#FF005048</item>
        <item name="colorOnPrimaryContainer">#FFB2DFDB</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#FF80CBC4</item>
        <item name="colorOnSecondary">#FF003731</item>
        <item name="colorSecondaryContainer">#FF005048</item>
        <item name="colorOnSecondaryContainer">#FFB2DFDB</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">#FF4D8C6B</item>
        <item name="colorOnTertiary">#FFFFFFFF</item>

        <!-- Surface and Background -->
        <item name="colorSurface">#FF1C1B1F</item>
        <item name="colorOnSurface">#FFE6E1E5</item>
        <item name="android:colorBackground">#FF1C1B1F</item>
        <item name="colorOnBackground">#FFE6E1E5</item>

        <!-- Error color -->
        <item name="colorError">#FFEF5350</item>
        <item name="colorOnError">#FFFFFFFF</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">#FF1C1B1F</item>
        <item name="android:navigationBarColor">#FF1C1B1F</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_wrapper</item>
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>
